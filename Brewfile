# macOS packages: brew bundle --file ~/.dotfiles/Brewfile
# "##" comments are shown in `dots help`

# distributed version control
brew "git"
# large files in git (git lfs pull)
brew "git-lfs"
## GitHub cli (gh repo, gh auth)
brew "gh"

## fuzzy finder behind Ctrl-R, Ctrl-T, Alt-C and Up
brew "fzf"
## node version manager, switches on cd from .nvmrc
brew "fnm"
## per-dir env vars from .envrc (~/evo)
brew "direnv"

## find replacement: fd name, fd -e png, fd -x cmd
brew "fd"
## fast recursive search respecting .gitignore: rg pattern, rg -l, rg -t js
brew "ripgrep"
## grep-compatible faster grep, `grep` is aliased to it; ug -Q for interactive search
brew "ugrep"
## cat with syntax highlighting and line numbers: bat file
brew "bat"
## jump to frecent dirs: z evo, zi to pick
brew "zoxide"
## simplified man pages: tldr cmd
brew "tlrc"
## JSON processor: jq '.data[0]'
brew "jq"

## JS/TS runtime (deno -A, deno run)
brew "deno"
## launches project-pinned yarn (yarnPath) in ~/evo/js-clients
brew "yarn"
## python tools and projects: uv tool install, uvx, uv run
brew "uv"

## audio/video conversion: ffmpeg -i
brew "ffmpeg"
## image conversion: magick mogrify, magick identify
brew "imagemagick"
# image metadata, used by img-date-prefix
brew "exiftool"
## graph rendering: dot file.txt
brew "graphviz"
## live GLSL shader preview: glslViewer file.frag
brew "glslviewer"
## sync www art assets with Cloudflare R2 (art:r2copy, art:r2sync)
brew "rclone"

# terminal
cask "ghostty"
# Ghostty hotkey window (Ctrl+§ / Ctrl+`)
cask "hammerspoon"
# terminal font
cask "font-daddy-time-mono-nerd-font"
# local LLM server (localhost:11434), models in ~/.ollama
cask "ollama-app"

# future: App Store apps (needs brew "mas") and GUI apps installed by hand,
# adopt existing ones with: brew install --cask --adopt <app>
