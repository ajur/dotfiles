#!/usr/bin/env zsh

export PATH="/opt/homebrew/bin:$PATH"

mode=$1
shift

case $mode in
  mp4-high)
    TITLE="MP4 – high"
    CRF=20
    PRESET=medium
    AKB=160
    VF=()
    SUFFIX=""
    ;;
  mp4-low)
    TITLE="MP4 – scaled"
    CRF=21
    FPS=30
    PRESET=veryfast
    AKB=128
    VF=(-vf "scale=trunc(iw/4)*2:-2,fps=$FPS")
    SUFFIX="-scaled"
    ;;
  gif)
    TITLE="GIF"
    FPS=15
    MAXW=640
    DITHER="bayer:bayer_scale=5:diff_mode=rectangle"
    ;;
esac

for f in "$@"; do
  if [ "$mode" = gif ]; then
    ffmpeg -nostdin -n -i "$f" \
      -map 0:v:0 \
      -vf "fps=$FPS,scale='min($MAXW,iw)':-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=$DITHER" \
      "${f%.*}.gif" || failed="$failed$(basename "$f") "
  else
    ffmpeg -nostdin -n -i "$f" \
      -map 0:v:0 -map "0:a?" \
      "${VF[@]}" \
      -c:v libx264 -crf "$CRF" -preset "$PRESET" -pix_fmt yuv420p \
      -c:a aac -b:a "${AKB}k" \
      -movflags +faststart "${f%.*}$SUFFIX.mp4" || failed="$failed$(basename "$f") "
  fi
done

osascript -e "display notification \"${failed:-Done}\" with title \"$TITLE\""
